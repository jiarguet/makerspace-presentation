flowchart TB
    subgraph presentation_layer["PRESENTATION LAYER"]
        direction LR
        tui["Textual TUI (Phase 1)"]
        tauri["Tauri + React (Phase 2)"]
    end

    subgraph orchestration_layer["ORCHESTRATION LAYER"]
        direction LR
        stategraph["LangGraph StateGraph"]
        saver["SqliteSaver checkpoint"]
    end

    subgraph persona_layer["PERSONA LAYER"]
        direction LR
        pydantic["PydanticAI agents"]
        prompt_writer["PromptWriter"]
        planner["Planner"]
        executor["Executor"]
        tester["Tester"]
        pydantic --> prompt_writer
        pydantic --> planner
        pydantic --> executor
        pydantic --> tester
    end

    subgraph llm_layer["LLM LAYER"]
        direction LR
        litellm["LiteLLM router"]
        claude["Anthropic Claude"]
        gpt["OpenAI GPT"]
        ollama["Ollama (local)"]
    end

    subgraph context_layer["CONTEXT LAYER"]
        direction LR
        llamaindex["LlamaIndex + BM25"]
        lancedb["LanceDB (future vector)"]
        watchdog["Watchdog file watcher"]
    end

    subgraph storage_layer["STORAGE LAYER"]
        direction LR
        sqlite["SQLite / SQLModel"]
        yaml["YAML files"]
        toml["TOML config"]
    end

    subgraph integration_layer["INTEGRATION LAYER"]
        direction LR
        mcp["Godot MCP Pro"]
        gitpython["GitPython"]
        plyer["plyer (notifications)"]
    end

    %% UI → Orchestration
    tui --> stategraph
    tauri --> stategraph
    stategraph --> saver

    %% Orchestration → Personas
    stategraph --> pydantic

    %% Personas → LLM
    prompt_writer --> litellm
    planner --> litellm
    executor --> litellm
    tester --> litellm
    litellm --> claude
    litellm --> gpt
    litellm --> ollama

    %% Personas → Context (RAG)
    prompt_writer --> llamaindex
    planner --> llamaindex
    executor --> llamaindex
    tester --> llamaindex
    watchdog --> llamaindex
    llamaindex --> lancedb

    %% Context → Storage
    llamaindex --> sqlite
    sqlite --> yaml
    yaml --> toml

    %% Personas → Integration
    executor --> mcp
    stategraph --> gitpython
    stategraph --> plyer

