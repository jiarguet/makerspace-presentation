flowchart LR
    story_yaml["Story YAML<br/>(human writes)"] --> gtg_gate{"GTG Gate"}
    gtg_gate -->|approved + deps closed| prompt_gen["PromptGen"]
    prompt_gen --> prompt_gate{"Prompt Approval Gate<br/>prompt.md"}
    prompt_gate -->|approved| plan_gen["PlanGen"]
    plan_gen --> plan_approval["plan_approval<br/>(auto)"]
    plan_approval --> execute["Execute<br/>(AI + Godot MCP Pro)"]
    execute --> commit["Commit<br/>(GitPython, feature branch)"]
    commit --> test_gen["TestGen"]
    test_gen --> test_decision{"Test Result"}
    test_decision -->|PASS| pass_result["PASS"]
    test_decision -->|FAIL / GAPS| fail_result["FAIL / GAPS"]
    pass_result --> review_nonblocking["Non-blocking Review<br/>(branch merges to main)"]
    review_nonblocking --> story_closed["Story Closed"]
    fail_result --> review_blocking["Blocking Review<br/>(branch stays)"]
    review_blocking --> human_resolves["Human Resolves"]
    human_resolves --> execute

