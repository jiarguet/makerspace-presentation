flowchart LR
    subgraph source_layer["Data Sources"]
        direction TB
        obsidian["Obsidian Vault<br/>(design docs, epics)"]
        skills["Skill MDs<br/>(Godot patterns library)"]
        game_repo["Game Repo<br/>(live codebase)"]
    end

    subgraph processing_layer["Indexing + Retrieval"]
        direction LR
        watchdog["Watchdog<br/>(monitors file changes)"]
        llamaindex["LlamaIndex<br/>(parses, chunks)"]
        bm25["BM25 Index"]
        lancedb["LanceDB (future)"]
    end

    subgraph persona_layer["Persona Retrieval"]
        direction TB
        prompt_writer["PromptWriter<br/>(claude-sonnet-4.5)"]
        planner["Planner<br/>(claude-opus-4.7)"]
        executor["Executor<br/>(claude-sonnet-4.5 + MCP)"]
        tester["Tester<br/>(claude-haiku-4.5)"]
        mcp["Godot MCP Pro"]
    end

    obsidian --> watchdog
    skills --> watchdog
    game_repo --> watchdog
    watchdog --> llamaindex --> bm25
    llamaindex -.future vector.-> lancedb
    bm25 -->|design_docs + epics + skills| prompt_writer
    bm25 -->|game_repo + skills| planner
    bm25 -->|game_repo + skills| executor
    bm25 -->|game_repo + story acceptance criteria| tester
    mcp -.tool access.-> executor

