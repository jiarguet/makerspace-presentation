        executor["Executor"]
        tester["Tester"]
        pydantic --> prompt_writer
        pydantic --> planner
        pydantic --> executor
        pydantic --> tester
    end

    subgraph llm_layer["LLM Layer"]
        direction LR
        litellm["LiteLLM"]
        claude_gpt["Claude / GPT"]
        ollama["Ollama (local)"]
        litellm --> claude_gpt
        litellm --> ollama
    end

    subgraph rag_layer["RAG Layer"]
        direction LR
        obsidian["Obsidian Vault"]
        skills["Skill MDs"]
        game_repo["Game Repo"]
        rag["LlamaIndex + BM25"]
        obsidian --> rag
        skills --> rag
        game_repo --> rag
    end

    subgraph storage_layer["Storage"]
        direction LR
        sqlite["SQLite / SQLModel<br/>story / epic state"]
        gitpython["GitPython<br/>VCS"]
    end

    subgraph integration_layer["Integration"]
        direction LR
        mcp["Godot MCP Pro"]
    end

    tui --> stategraph
